import cv2

# 1. Read the main image
main = cv2.imread("car.jpg")

# 2. Read the watermark image
wm = cv2.imread("mylogo.png")

# 3. Resize watermark (optional)
wm = cv2.resize(wm, (100, 50))  # width=100px, height=50px

# 4. Choose where to put the watermark
x, y = 10, 10  # 10 pixels from top-left corner

# 5. Place the watermark on the main image
main[y:y+wm.shape[0], x:x+wm.shape[1]] = wm

# 6. Show the result
cv2.imshow("Watermarked Image", main)
cv2.waitKey(0)
cv2.destroyAllWindows()
