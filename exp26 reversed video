import cv2

# Open the input video
cap = cv2.VideoCapture("input.mp4")

frames = []

# Read all frames
while True:
    ret, frame = cap.read()
    if not ret:
        break
    frames.append(frame)

cap.release()

# Get video properties
height, width, layers = frames[0].shape
fps = 30  # You can also get fps from video

# Create VideoWriter for reversed video
out = cv2.VideoWriter(
    "reversed_video.mp4",
    cv2.VideoWriter_fourcc(*'mp4v'),
    fps,
    (width, height)
)

# Write frames in reverse order
for frame in reversed(frames):
    out.write(frame)

out.release()

print("Video reversed successfully!")
